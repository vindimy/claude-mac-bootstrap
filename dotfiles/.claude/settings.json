{
  "includeCoAuthoredBy": false,
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/dv/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"/opt/homebrew/bin/node\" \"/Users/dv/.claude/hooks/gsd-statusline.js\""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-mem@thedotmack": false,
    "andrej-karpathy-skills@karpathy-skills": false,
    "frontend-design@claude-plugins-official": true,
    "cloudflare@cloudflare": false,
    "understand-anything@understand-anything": false,
    "context-mode@context-mode": true,
    "mattpocock-skills@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": false,
    "document-skills@anthropic-agent-skills": false,
    "humanizer@humanizer": false,
    "ecc@ecc": false
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
