# Legacy per-machine selection location (pre-2026-09-03) — never committed.
# The selection now lives in ~/.mac-bootstrap/apps.conf; load_config adopts
# any leftover local/<hostname>.conf automatically.
local/

# Global Claude Code config (dotfiles/.claude): only settings.json and the
# status line script it points at are versioned. Everything else that lives
# in a real ~/.claude — sessions, history, plugin caches, credentials, memory,
# local overrides — is per-machine state.
dotfiles/.claude/*
!dotfiles/.claude/settings.json
!dotfiles/.claude/statusline-command.sh
